2026-10-13T19:28:16.275Z CLI debug [testhub:request-queue-handler]  [vvcvibxdn7oen4v8yxktwajbzxwpsqpuaplfitpc]  [a7635c78-55ec-4e94-be44-7d05437dc219]  Event Batch [{"event_type":"TestRunFinished","test_run":{"type":"test","framework":"pytest","uuid":"b9e18d22-b57f-4f43-aefb-1772adee30a9","name":"test_select_halal_pref","body":{"lang":"python","code":"def test_select_halal_pref():\n    options = XCUITestOptions().load_capabilities({\n        \"platformName\": \"iOS\",\n        \"automationName\": \"XCUITest\",\n    })\n\n    driver = webdriver.Remote(\n        \"http://127.0.0.1:4723\",\n        options=options\n    )\n\n    try:\n        wait = WebDriverWait(driver, 30)\n\n        # Temporary time for manually preparing the precondition:\n        # User is logged in and positioned on the home screen.\n        time.sleep(60)\n\n        # Confirm home screen and open Account.\n        nav_account = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Account\"\n            ))\n        )\n\n        assert nav_account.is_displayed()\n        print(\"User is on the home screen.\")\n\n        nav_account.click()\n\n        # Scroll to Halal Preference using an iOS command.\n        driver.execute_script(\n            \"mobile: scroll\",\n            {\"name\": \"Halal preference\"}\n        )\n\n        halal_pref_nav = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Halal preference\"\n            ))\n        )\n\n        halal_pref_nav.click()\n\n        # Confirm preference screen.\n        halal_pref_section = wait.until(\n            EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Select Your Halal Preference\"\n            ))\n        )\n\n        assert halal_pref_section.is_displayed()\n\n        # Replace this value with the exact accessibility ID\n        # displayed in Appium Inspector for the iOS element.\n        fully_certified = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Fully halal-certified\"\n            ))\n        )\n\n        fully_certified.click()\n\n        save_preference = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Save\"\n            ))\n        )\n\n        save_preference.click()\n\n        # Verify confirmation.\n        confirmation = WebDriverWait(\n            driver,\n            5,\n            poll_frequency=0.2\n        ).until(\n            EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Halal preference saved\"\n            ))\n        )\n\n        assert confirmation.is_displayed()\n        print(\"Halal preference saved successfully.\")\n\n    finally:\n        driver.quit()\n"},"identifier":"test_select_halal_pref","scope":"test_select_halal_pref","scopes":["tests","user_app","select_halal_prefer_bs_ios.py"],"file_name":"tests\\user_app\\select_halal_prefer_bs_ios.py","vc_filepath":"tests\\user_app\\select_halal_prefer_bs_ios.py","location":"tests\\user_app\\select_halal_prefer_bs_ios.py","result":"failed","duration_in_ms":129246,"started_at":"2026-10-13T19:26:03.145Z","finished_at":"2026-10-13T19:28:12.391Z","failure":[{"backtrace":["selenium.common.exceptions.TimeoutException: Message: \nStacktrace:\nNoSuchElementError: An element could not be located on the page using the given search parameters.\n    at XCUITestDriver.doNativeFind (/nix/store/aq9s7ww0fgswwbyrbqky14v52xlwyzpd-appium-2.19.0/packages/appium/xcuitest/9.9.6/node_modules/appium-xcuitest-driver/lib/commands/find.js:143:13)\n    at processTicksAndRejections (node:internal/process/task_queues:95:5)\n    at XCUITestDriver.findNativeElementOrElements (/nix/store/aq9s7ww0fgswwbyrbqky14v52xlwyzpd-appium-2.19.0/packages/appium/xcuitest/9.9.6/node_modules/appiu
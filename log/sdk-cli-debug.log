      name: 'test_password_match_registr',
      body: {
        lang: 'python',
        code: 'def test_password_match_registr():\n' +
          '    options = XCUITestOptions().load_capabilities({\n' +
          '        "platformName": "iOS",\n' +
          '        "automationName": "XCUITest",\n' +
          '    })\n' +
          '\n' +
          '    driver = webdriver.Remote(\n' +
          '        "http://127.0.0.1:4723",\n' +
          '        options=options\n' +
          '    )\n' +
          '\n' +
          '    time.sleep(30)\n' +
          '\n' +
          '    wait = WebDriverWait(driver, 15)\n' +
          '\n' +
          '    # Pre-requisites:\n' +
          '    # The driver should be logged out.\n' +
          '    # A unique email and phone must already be entered.\n' +
          '    # User should be on the create password page before entry of this test case.\n' +
          '\n' +
          '    try:\n' +
          '        active_app = driver.execute_script("mobile: activeAppInfo")\n' +
          '\n' +
          '        assert active_app["bundleId"] == "com.halaleats.provider"\n' +
          '        print("user is on driver app")\n' +
          '\n' +
          '        # Clicks on Get Started button.\n' +
          '        get_started = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Get Started"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        get_started.click()\n' +
          '\n' +
          '        # Assert if the system is on Create Account page.\n' +
          '        create_account = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Create account"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        assert create_account.is_displayed()\n' +
          '\n' +
          '        # Clicks on first-name field and shows keyboard.\n' +
          '        # Android instance(0) becomes XPath index [1] on iOS.\n' +
          '        f_name_input = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.XPATH,\n' +
          '                "(//XCUIElementTypeTextField | "\n' +
          '                "//XCUIElementTypeSecureTextField)[1]"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        f_name_input.click()\n' +
          '\n' +
          '        WebDriverWait(driver, 10).until(\n' +
          '            lambda d: d.is_keyboard_shown()\n' +
          '        )\n' +
          '\n' +
          '        assert driver.is_keyboard_shown()\n' +
          '\n' +
          '        # Finds password field on the page.\n' +
          '        # Equivalent to scrollToEnd(3).\n' +
          '        for _ in range(3):\n' +
          '            driver.execute_script(\n' +
          '                "mobile: scroll",\n' +
          '                {"direction": "down"}\n' +
          '            )\n' +
          '\n' +
          '        password_field_scroll = driver.find_element(\n' +
          '            AppiumBy.ACCESSIBILITY_ID,\n' +
          '            "Password *"\n' +
          '        )\n' +
          '\n' +
          '        assert password_field_scroll.is_displayed()\n' +
          '\n' +
          '        # Populates password field.\n' +
          '        # Android instance(2) becomes XPath index [3] on iOS.\n' +
          '        password_field = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.XPATH,\n' +
          '                "(//XCUIElementTypeTextField | "\n' +
          '                "//XCUIElementTypeSecureTextField)[3]"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        password_field.click()\n' +
          '        password_field.clear()\n' +
          '        password_field.send_keys(input_password)\n' +
          '\n' +
          '        # Finds Confirm Password field on the page.\n' +
          '        driver.execute_script(\n' +
          '            "mobile: scroll",\n' +
          '            {"direction": "down"}\n' +
          '        )\n' +
          '\n' +
          '        driver.execute_script(\n' +
          '            "mobile: scroll",\n' +
          '            {"name": "Confirm Password *"}\n' +
          '        )\n' +
          '\n' +
          '        confirm_password_field_scroll = driver.find_element(\n' +
          '            AppiumBy.ACCESSIBILITY_ID,\n' +
          '            "Confirm Password *"\n' +
          '        )\n' +
          '\n' +
          '        assert confirm_password_field_scroll.is_displayed()\n' +
          '\n' +
          '        # Re-enters the same password.\n' +
          '        # The same dynamic third-field index is retained.\n' +
          '        confirm_password_field = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.XPATH,\n' +
          '                "(//XCUIElementTypeTextField | "\n' +
          '                "//XCUIElementTypeSecureTextField)[3]"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        confirm_password_field.click()\n' +
          '        confirm_password_field.clear()\n' +
          '        confirm_password_field.send_keys(input_confirm_password)\n' +
          '\n' +
          '        # Asserts Password Match message.\n' +
          '        success_message = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Password Match"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        assert success_message.is_displayed()\n' +
          '\n' +
          '    finally:\n' +
          '        driver.quit()\n'
      },
      identifier: 'test_password_match_registr',

    name: 'test_select_halal_pref',
    body: {
      lang: 'python',
      code: 'def test_select_halal_pref():\n' +
        '    options = XCUITestOptions().load_capabilities({\n' +
        '        "platformName": "iOS",\n' +
        '        "automationName": "XCUITest",\n' +
        '    })\n' +
        '\n' +
        '    driver = webdriver.Remote(\n' +
        '        "http://127.0.0.1:4723",\n' +
        '        options=options\n' +
        '    )\n' +
        '\n' +
        '    try:\n' +
        '        wait = WebDriverWait(driver, 30)\n' +
        '\n' +
        '        # Temporary time for manually preparing the precondition:\n' +
        '        # User is logged in and positioned on the home screen.\n' +
        '        time.sleep(60)\n' +
        '\n' +
        '        # Confirm home screen and open Account.\n' +
        '        nav_account = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Account"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        assert nav_account.is_displayed()\n' +
        '        print("User is on the home screen.")\n' +
        '\n' +
        '        nav_account.click()\n' +
        '\n' +
        '        # Scroll to Halal Preference using an iOS command.\n' +
        '        driver.execute_script(\n' +
        '            "mobile: scroll",\n' +
        '            {"name": "Halal preference"}\n' +
        '        )\n' +
        '\n' +
        '        halal_pref_nav = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Halal preference"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        halal_pref_nav.click()\n' +
        '\n' +
        '        # Confirm preference screen.\n' +
        '        halal_pref_section = wait.until(\n' +
        '            EC.visibility_of_element_located((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Select Your Halal Preference"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        assert halal_pref_section.is_displayed()\n' +
        '\n' +
        '        # Replace this value with the exact accessibility ID\n' +
        '        # displayed in Appium Inspector for the iOS element.\n' +
        '        fully_certified = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Fully halal-certified"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        fully_certified.click()\n' +
        '\n' +
        '        save_preference = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Save"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        save_preference.click()\n' +
        '\n' +
        '        # Verify confirmation.\n' +
        '        confirmation = WebDriverWait(\n' +
        '            driver,\n' +
        '            5,\n' +
        '            poll_frequency=0.2\n' +
        '        ).until(\n' +
        '            EC.visibility_of_element_located((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Halal preference saved"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        assert confirmation.is_displayed()\n' +
        '        print("Halal preference saved successfully.")\n' +
        '\n' +
        '    finally:\n' +
        '        driver.quit()\n'
    },
    identifier: 'test_select_halal_pref',

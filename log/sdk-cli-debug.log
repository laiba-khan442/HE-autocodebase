    name: 'test_password_match_registration',
    body: {
      lang: 'python',
      code: 'def test_password_match_registration():\n' +
        '    options = XCUITestOptions().load_capabilities({\n' +
        '        "platformName": "iOS",\n' +
        '        "automationName": "XCUITest",\n' +
        '    })\n' +
        '\n' +
        '    driver = webdriver.Remote(\n' +
        '        "http://127.0.0.1:4723",\n' +
        '        options=options\n' +
        '    )\n' +
        '\n' +
        '    try:\n' +
        '        wait = WebDriverWait(driver, 20)\n' +
        '\n' +
        '        # Manual preparation window.\n' +
        '        print("Prepare the registration screen within 30 seconds.")\n' +
        '        time.sleep(30)\n' +
        '\n' +
        '        # Open registration.\n' +
        '        get_started = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Get Started"\n' +
        '            ))\n' +
        '        )\n' +
        '        get_started.click()\n' +
        '\n' +
        '        # Confirm registration page.\n' +
        '        create_account = wait.until(\n' +
        '            EC.visibility_of_element_located((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Create account"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        assert create_account.is_displayed()\n' +
        '\n' +
        '    # Clicks on first_name field and shows keyboard.\n' +
        '        f_name_input = wait.until(\n' +
        '        EC.visibility_of_element_located(\n' +
        '         (\n' +
        '             AppiumBy.IOS_PREDICATE,\n' +
        `             '(type == "XCUIElementTypeSecureTextField" OR '\n` +
        `             'type == "XCUIElementTypeTextField") AND '\n` +
        `             '(name == "First Name *" OR label == "First Name *")'\n` +
        '         ))\n' +
        '        )\n' +
        '        f_name_input.click()\n' +
        '\n' +
        '        WebDriverWait(driver, 10).until(lambda d: d.is_keyboard_shown())\n' +
        '\n' +
        '        assert driver.is_keyboard_shown()\n' +
        '\n' +
        '        # Scroll downward to the password section.\n' +
        '        driver.execute_script(\n' +
        '            "mobile: scroll",\n' +
        '            {"direction": "down"}\n' +
        '        )\n' +
        '\n' +
        '        # Find and populate Password.\n' +
        '        password_field = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.IOS_PREDICATE,\n' +
        `                '(type == "XCUIElementTypeSecureTextField" OR '\n` +
        `                'type == "XCUIElementTypeTextField") AND '\n` +
        `                '(name == "Password *" OR label == "Password *")'\n` +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        password_field.click()\n' +
        '        password_field.clear()\n' +
        '        password_field.send_keys(input_password)\n' +
        '\n' +
        '        driver.back()\n' +
        '\n' +
        '        # Scroll downward to Confirm Password.\n' +
        '        driver.execute_script(\n' +
        '            "mobile: scroll",\n' +
        '            {"direction": "down"}\n' +
        '        )\n' +
        '\n' +
        '        # Find and populate Confirm Password.\n' +
        '        confirm_password_field = wait.until(\n' +
        '            EC.element_to_be_clickable((\n' +
        '                AppiumBy.IOS_PREDICATE,\n' +
        `                '(type == "XCUIElementTypeSecureTextField" OR '\n` +
        `                'type == "XCUIElementTypeTextField") AND '\n` +
        `                '(name == "Confirm Password *" OR '\n` +
        `                'label == "Confirm Password *")'\n` +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        confirm_password_field.click()\n' +
        '        confirm_password_field.clear()\n' +
        '        confirm_password_field.send_keys(input_confirm_password)\n' +
        '\n' +
        '        # Verify matching-password message.\n' +
        '        success_message = wait.until(\n' +
        '            EC.visibility_of_element_located((\n' +
        '                AppiumBy.ACCESSIBILITY_ID,\n' +
        '                "Password Match"\n' +
        '            ))\n' +
        '        )\n' +
        '\n' +
        '        assert success_message.is_displayed()\n' +
        '        print("Password Match message displayed successfully.")\n' +
        '\n' +
        '    finally:\n' +
        '        driver.quit()\n'
    },
    identifier: 'test_password_match_registration',
    scope: 'test_password_match_registration',

      EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Select Your Halal Preference\"\n            ))\n        )\n\n        assert preference_heading.is_displayed()\n        print(\"Halal preference screen opened.\")\n\n        # Select Fully Halal Certified.\n        fully_certified = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.IOS_PREDICATE,\n                'name == \"Fully Halal Certified\" OR '\n                'label == \"Fully Halal Certified\"'\n            ))\n        )\n\n        fully_certified.click()\n\n        # The iOS screen shows Continue, not Save.\n        continue_button = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.IOS_PREDICATE,\n                'type == \"XCUIElementTypeButton\" AND '\n                '(name CONTAINS \"Continue\" OR label CONTAINS \"Continue\")'\n            ))\n        )\n\n        continue_button.click()\n\n        # Capture the short confirmation message.\n        confirmation = WebDriverWait(\n            driver,\n            5,\n            poll_frequency=0.1\n        ).until(\n            EC.presence_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Halal preference saved\"\n            ))\n        )\n\n        assert confirmation.is_displayed()\n        print(\"Halal preference saved successfully.\")\n\n    finally:\n        driver.quit()\n"},"identifier":"test_select_halal_pref","scope":"test_select_halal_pref","scopes":["tests","user_app","select_halal_prefer_bs_ios.py"],"file_name":"tests\\user_app\\select_halal_prefer_bs_ios.py","vc_filepath":"tests\\user_app\\select_halal_prefer_bs_ios.py","location":"tests\\user_app\\select_halal_prefer_bs_ios.py","result":"failed","duration_in_ms":137816,"started_at":"2026-10-14T17:36:18.511Z","finished_at":"2026-10-14T17:38:36.327Z","failure":[{"backtrace":["selenium.common.exceptions.TimeoutException: Message: \nStacktrace:\n
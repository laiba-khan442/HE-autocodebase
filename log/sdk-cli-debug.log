browserstack_executor: {\"action\":\"updateIosDeviceSettings\",'\n        '\"arguments\":{\"LocationServices\":\"ON\"}}'\n    )\n    driver.execute_script(\n        'browserstack_executor: {'\n        '\"action\":\"updateAppSettings\",'\n        '\"arguments\":{\"Permission Settings\":{'\n        '\"Location\":{\"ALLOW LOCATION ACCESS\":\"While Using the App\"}'\n        '}}}'\n    )\n\n    time.sleep(10)\n\n    driver.terminate_app(\"com.halaleats.customer\")\n\n    time.sleep(10)\n\n    driver.activate_app(\"com.halaleats.customer\")\n\n    time.sleep(10)\n\n    wait = WebDriverWait(driver, 15)\n\n    try:\n        # Confirm home screen and open Account.\n        nav_account = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Account\"\n            ))\n        )\n\n        assert nav_account.is_displayed()\n        print(\"User is on the home screen.\")\n\n        nav_account.click()\n\n        # Scroll to Halal Preference using an iOS command.\n        driver.execute_script(\n            \"mobile: scroll\",\n            {\"name\": \"Halal preference\"}\n        )\n\n        halal_pref_nav = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Halal preference\"\n            ))\n        )\n\n        halal_pref_nav.click()\n\n        # Confirm preference screen.\n        halal_pref_section = wait.until(\n            EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Select Your Halal Preference\"\n            ))\n        )\n\n        assert halal_pref_section.is_displayed()\n\n        # Replace this value with the exact accessibility ID\n        # displayed in Appium Inspector for the iOS element.\n        fully_certified = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Fully halal-certified\"\n            ))\n        )\n\n        fully_certified.click()\n\n        save_preference = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Save\"\n            ))\n        )\n\n        save_preference.click()\n\n        # Verify confirmation.\n        confirmation = WebDriverWait(\n            driver,\n            5,\n            poll_frequency=0.2\n        ).until(\n            EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Halal preference saved\"\n            ))\n        )\n\n        assert confirmation.is_displayed()\n        print(\"Halal preference saved successfully.\")\n\n    finally:\n        driver.quit()\n"},"identifier":"test_select_halal_pref","scope":"test_select_halal_pref","scopes":["tests","user_app","select_halal_prefer_bs_ios.py"],"file_name":"tests\\user_app\\select_halal_prefer_bs_ios.py","vc_filepath":"tests\\user_app\\select_halal_prefer_bs_ios.py","location":"tests\\user_app\\select_halal_prefer_bs_ios.py","result":"pending","duration_in_ms":null,"started_at":"2026-10-14T16:48:32.668Z","failure_reason":null,"retry_of":null,"tags":[],"customRerunParam":{"rerun_name":"tests/user_app/select_halal_prefer_bs_ios.py::test_select_halal_pref"},"hooks":[],"product_map":{"observability":true,"accessibility":false,"percy":false,"automate":false,"app_automate":true,"lts":false}},"logs":[]}]

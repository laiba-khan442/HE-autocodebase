field.send_keys(input_password)\n\n        # Close the keyboard before scrolling.\n        if driver.is_keyboard_shown():\n            driver.hide_keyboard()\n\n        # Scroll downward to Confirm Password.\n        driver.execute_script(\n            \"mobile: scroll\",\n            {\"direction\": \"down\"}\n        )\n\n        # Find and populate Confirm Password.\n        confirm_password_field = wait.until(\n            EC.element_to_be_clickable((\n                AppiumBy.IOS_PREDICATE,\n                '(type == \"XCUIElementTypeSecureTextField\" OR '\n                'type == \"XCUIElementTypeTextField\") AND '\n                '(name == \"Confirm Password *\" OR '\n                'label == \"Confirm Password *\")'\n            ))\n        )\n\n        confirm_password_field.click()\n        confirm_password_field.clear()\n        confirm_password_field.send_keys(input_confirm_password)\n\n        # Verify matching-password message.\n        success_message = wait.until(\n            EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Password Match\"\n            ))\n        )\n\n        assert success_message.is_displayed()\n        print(\"Password Match message displayed successfully.\")\n\n    finally:\n        driver.quit()\n"},"identifier":"test_password_match_registration","scope":"test_password_match_registration","scopes":["tests","driver_app","HE_CR_20260918_01","test_password_match_registr_bs_ios.py"],"file_name":"tests\\driver_app\\HE_CR_20260918_01\\test_password_match_registr_bs_ios.py","vc_filepath":"tests\\driver_app\\HE_CR_20260918_01\\test_password_match_registr_bs_ios.py","location":"tests\\driver_app\\HE_CR_20260918_01\\test_password_match_registr_bs_ios.py","result":"failed","duration_in_ms":105179,"started_at":"2026-10-14T19:44:05.043Z","finished_at":"2026-10-14T19:45:50.222Z","failure":[{"backtrace":["selenium.common.exceptions.TimeoutException: Message: \nStacktrace:\nNoSuchElementErr
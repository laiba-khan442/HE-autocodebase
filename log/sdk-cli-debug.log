      type: 'test',
      framework: 'pytest',
      uuid: '4894fbc4-74de-4092-9307-595939864e95',
      name: 'test_select_halal_pref',
      body: {
        lang: 'python',
        code: 'def test_select_halal_pref():\n' +
          '    options = UiAutomator2Options().load_capabilities({\n' +
          '        "platformName": "iOS",\n' +
          '        "automationName": "XCUITest",\n' +
          '    })\n' +
          '\n' +
          '\n' +
          '    driver = webdriver.Remote(\n' +
          '        "http://127.0.0.1:4723",\n' +
          '        options=options\n' +
          '    )\n' +
          '\n' +
          '    wait = WebDriverWait(driver, 15)\n' +
          '\n' +
          '    time.sleep(60)\n' +
          '\n' +
          '# pre-requisite: user should be logged in and should be on the home page.\n' +
          '\n' +
          '    try:\n' +
          '        assert driver.current_package == "com.halaleats.user"\n' +
          '        print("user is on homescreen")\n' +
          '\n' +
          '        # clicks on account\n' +
          '\n' +
          '        nav_account = wait.until(\n' +
          '             EC.visibility_of_element_located(\n' +
          '                 (\n' +
          '                     AppiumBy.ACCESSIBILITY_ID,\n' +
          "                     'Account'\n" +
          '                 )\n' +
          '             ))\n' +
          '        nav_account.click()\n' +
          '\n' +
          '        account_section = wait.until(\n' +
          '              EC.element_to_be_clickable(\n' +
          '                  (AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          `                      'new UiSelector().description("Account").instance(1)'\n` +
          '                  )\n' +
          '              )\n' +
          '          )\n' +
          '\n' +
          '        assert account_section.is_displayed()\n' +
          '\n' +
          '        # navigates payment method section\n' +
          '\n' +
          '        halal_pref_nav = driver.find_element(\n' +
          '                 AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          "                 'new UiScrollable(new UiSelector().scrollable(true))'\n" +
          `                 '.scrollIntoView(new UiSelector().description("Halal preference"))'\n` +
          '                 )\n' +
          '\n' +
          '        halal_pref_nav.click()\n' +
          '\n' +
          '        halal_pref_sect = wait.until(\n' +
          '              EC.element_to_be_clickable(\n' +
          '                  (AppiumBy.ACCESSIBILITY_ID,\n' +
          "                      'Select Your Halal Preference'\n" +
          '                  )\n' +
          '              )\n' +
          '          )\n' +
          '        assert halal_pref_sect.is_displayed()\n' +
          '\n' +
          '        #selects fully halal-certified badge\n' +

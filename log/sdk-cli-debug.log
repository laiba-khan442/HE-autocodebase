XCUIElementTypeSecureTextField)[1]\"\n            ))\n        )\n\n        f_name_input.click()\n\n        WebDriverWait(driver, 10).until(\n            lambda d: d.is_keyboard_shown()\n        )\n\n        assert driver.is_keyboard_shown()\n\n        # Finds the form's scrollable container.\n        form_scroll = wait.until(\n            EC.presence_of_element_located((\n                AppiumBy.CLASS_NAME,\n                \"XCUIElementTypeScrollView\"\n            ))\n        )\n\n        # Finds Password field on the page.\n        # Scroll is restricted to the form so it does not\n        # interact with the open iOS keyboard.\n        for _ in range(3):\n            driver.execute_script(\n                \"mobile: scroll\",\n                {\n                    \"elementId\": form_scroll.id,\n                    \"direction\": \"down\"\n                }\n            )\n\n        password_field_scroll = driver.find_element(\n            AppiumBy.ACCESSIBILITY_ID,\n            \"Password *\"\n        )\n\n        assert password_field_scroll.is_displayed()\n\n        # Populates Password field.\n        # Android instance(2) becomes XPath index [3] on iOS.\n        password_field = wait.until(\n            EC.visibility_of_element_located((\n                AppiumBy.XPATH,\n                \"(//XCUIElementTypeTextField | \"\n                \"//XCUIElementTypeSecureTextField)[3]\"\n            ))\n        )\n\n        password_field.click()\n        password_field.clear()\n        password_field.send_keys(input_password)\n\n        # Finds Confirm Password field on the page.\n        # Keyboard remains open.\n        driver.execute_script(\n            \"mobile: scroll\",\n            {\n                \"elementId\": form_scroll.id,\n                \"direction\": \"down\"\n            }\n        )\n\n        driver.execute_script(\n            \"mobile: scroll\",\n            {\n                \"elementId\": form_scroll.id,\n                \"name\": \"Confirm Password *\"\n            }\n        )\n\n        confirm_password_field_scroll = driver.find_element(\n            AppiumBy.ACCESSIBILITY_ID,\n            \"Confirm Password *\"\n        )\n\n        assert confirm_password_field_scroll.is_displayed()\n\n        # Re-enters the same password.\n        # The dynamic third-field index remains unchanged.\n        confirm_password_field = wait.until(\n            EC.visibility_of_element_located((\n                AppiumBy.XPATH,\n                \"(//XCUIElementTypeTextField | \"\n                \"//XCUIElementTypeSecureTextField)[3]\"\n            ))\n        )\n\n        confirm_password_field.click()\n        confirm_password_field.clear()\n        confirm_password_field.send_keys(\n            input_confirm_password\n        )\n\n        # Asserts Password Match message.\n        success_message = wait.until(\n            EC.visibility_of_element_located((\n                AppiumBy.ACCESSIBILITY_ID,\n                \"Password Match\"\n            ))\n        )\n\n        assert success_message.is_displayed()\n\n    finally:\n        driver.quit()\n"},"identifier":"test_password_match_registr","scope":"test_password_match_registr","scopes":["tests","driver_app","HE_CR_20260918_01","test_password_match_registr_bs_ios.py"],"file_name":"tests\\driver_app\\HE_CR_20260918_01\\test_password_match_registr_bs_ios.py","vc_filepath":"tests\\driver_app\\HE_CR_20260918_01\\test_password_match_registr_bs_ios.py","location":"tests\\driver_app\\HE_CR_20260918_01\\test_password_match_registr_bs_ios.py","result":"failed","duration_in_ms":99876,"started_at":"2026-10-14T20:18:45.827Z","finished_at":"2026-10-14T20:20:25.703Z","failure":[{"backtrace":["selenium.common.exceptions.NoSuchElementException: Message: 'Confirm Password *' identifier didn't match any elements; For documentation on this error, please visit: https://www.selenium.dev/documentation/webdriver/troubleshooting/errors#nosuchelementexception\nStacktrace:\nNoSuc
      code: 'def test_valid_restaurant_login():\n' +
        '\n' +
        '    options = UiAutomator2Options().load_capabilities({\n' +
        '        "platformName": "Android",\n' +
        '        "automationName": "UiAutomator2",\n' +
        '    })\n' +
        '\n' +
        '    driver = webdriver.Remote(\n' +
        '        "http://127.0.0.1:4723",\n' +
        '        options=options\n' +
        '    )\n' +
        '\n' +
        '    time.sleep(60)\n' +
        '\n' +
        '    wait = WebDriverWait(driver, 15)\n' +
        '\n' +
        '    try:\n' +
        '        assert driver.current_package == "com.halaleats.store"\n' +
        '\n' +
        '        email_input = wait.until(\n' +
        '            EC.visibility_of_element_located(\n' +
        '                (\n' +
        '                    AppiumBy.ANDROID_UIAUTOMATOR,\n' +
        `                    'new UiSelector().className("android.widget.EditText").instance(0)'\n` +
        '                )\n' +
        '            )\n' +
        '        )\n' +
        '\n' +
        '        password_input = wait.until(\n' +
        '            EC.visibility_of_element_located(\n' +
        '                (\n' +
        '                    AppiumBy.ANDROID_UIAUTOMATOR,\n' +
        `                    'new UiSelector().className("android.widget.EditText").instance(1)'\n` +
        '                )\n' +
        '            )\n' +
        '        )\n' +
        '        email_input.click()\n' +
        '        email_input.clear()\n' +
        '        email_input.send_keys(test_email)\n' +
        '\n' +
        '        password_input.click()\n' +
        '        password_input.clear()\n' +
        '        password_input.send_keys(test_password)\n' +
        '\n' +
        '        login_button = wait.until(\n' +
        '            EC.element_to_be_clickable(\n' +
        '                (\n' +
        '                    AppiumBy.ACCESSIBILITY_ID,\n' +
        '                    "Continue to Login"\n' +
        '                )\n' +
        '            )\n' +
        '        )\n' +
        '\n' +
        '        login_button.click()\n' +
        '\n' +
        '        # asserts if dashboard is displayed, the accessibility Id for "restaurant status" section is being considered here.\n' +
        '\n' +
        '        wait = WebDriverWait(driver, 15)\n' +
        '\n' +
        '        dashboard = wait.until(\n' +
        '                    EC.element_to_be_clickable(\n' +
        '                        (\n' +
        '                            AppiumBy.ACCESSIBILITY_ID,\n' +
        '                            "Restaurant Status"\n' +
        '                        )\n' +
        '                    )\n' +
        '                )\n' +
        '\n' +
        '        assert dashboard.is_displayed()\n' +
        '\n' +
        '    finally:\n' +
        '        driver.quit()\n'
    },

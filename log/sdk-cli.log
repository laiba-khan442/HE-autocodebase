        '        "automationName": "XCUITest",\n' +
        '    })\n' +
        '\n' +
        '    driver = webdriver.Remote(\n' +
        '        "http://127.0.0.1:4723",\n' +
        '        options=options\n' +
        '    )\n' +
        '\n' +
        '    try:\n' +
        '        wait = WebDriverWait(driver, 20)\n' +
        '\n' +
        '        # Manual preparation window:\n' +
        '        # Grant permissions, complete onboarding/login,\n' +
        '        # and navigate to the home screen.\n' +
        '\n' +
        '        driver.execute_script(\n' +
        "            'browserstack_executor: {'\n" +
        `            '"action":"updateIosDeviceSettings",'\n` +
        `            '"arguments":{"LocationServices":"ON"}}'\n` +
        '        )\n' +
        '\n' +
        '        driver.execute_script(\n' +
        "            'browserstack_executor: {'\n" +
        `            '"action":"updateAppSettings",'\n` +
        `            '"arguments":{"Permission Settings":{'\n` +
        `            '"Location":{"ALLOW LOCATION ACCESS":"While Using the App"}'\n` +
        "            '}}}'\n" +
        '        )\n' +
        '\n' +
        '        driver.terminate_app("com.halaleats.customer")\n' +
        '        driver.activate_app("com.halaleats.customer")\n' +

      name: 'test_add_new_card',
      body: {
        lang: 'python',
        code: 'def test_add_new_card():\n' +
          '    options = UiAutomator2Options().load_capabilities({\n' +
          '        "platformName": "Android",\n' +
          '        "automationName": "UiAutomator2",\n' +
          '    })\n' +
          '\n' +
          '\n' +
          '    driver = webdriver.Remote(\n' +
          '        "http://127.0.0.1:4723",\n' +
          '        options=options\n' +
          '    )\n' +
          '\n' +
          '    wait = WebDriverWait(driver, 15)\n' +
          '\n' +
          '    time.sleep(120)\n' +
          '\n' +
          '# pre-requisite: user should be logged in and should be on the home page.\n' +
          '\n' +
          '    try:\n' +
          '        assert driver.current_package == "com.halaleats.user"\n' +
          '        print("user is on homescreen")\n' +
          '\n' +
          '        # clicks on account\n' +
          '\n' +
          '        nav_account = wait.until(\n' +
          '             EC.visibility_of_element_located(\n' +
          '                 (\n' +
          '                     AppiumBy.ACCESSIBILITY_ID,\n' +
          "                     'Account'\n" +
          '                 )\n' +
          '             ))\n' +
          '        nav_account.click()\n' +
          '\n' +
          '        account_section = wait.until(\n' +
          '              EC.element_to_be_clickable(\n' +
          '                  (AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          `                      'new UiSelector().description("Account").instance(1)'\n` +
          '                  )\n' +
          '              )\n' +
          '          )\n' +
          '\n' +
          '        assert account_section.is_displayed()\n' +
          '\n' +
          '        # navigates payment method section\n' +
          '\n' +
          '        payment_method = wait.until(\n' +
          '             EC.visibility_of_element_located(\n' +
          '                 (\n' +
          '                     AppiumBy.ACCESSIBILITY_ID,\n' +
          "                     'Payment Method'\n" +
          '                 )\n' +
          '             ))\n' +
          '        payment_method.click()\n' +
          '\n' +
          '        payment_method_sect = wait.until(\n' +
          '              EC.element_to_be_clickable(\n' +
          '                  (AppiumBy.ACCESSIBILITY_ID,\n' +
          "                      'Payment methods'\n" +
          '                  )\n' +
          '              )\n' +
          '          )\n' +
          '        assert payment_method_sect.is_displayed()\n' +
          '\n' +
          '            # clicks on add new card\n' +
          '\n' +
          '        add_card = wait.until(\n' +
          '             EC.visibility_of_element_located(\n' +
          '                 (\n' +
          '                     AppiumBy.ACCESSIBILITY_ID,\n' +
          "                     'Add new card'\n" +
          '                 )\n' +
          '             ))\n' +
          '        add_card.click()\n' +
          '\n' +
          '        add_card_sect = wait.until(\n' +
          '              EC.element_to_be_clickable(\n' +
          '                  (AppiumBy.ACCESSIBILITY_ID,\n' +
          "                      'Add card'\n" +
          '                  )\n' +
          '              )\n' +
          '          )\n' +
          '        assert add_card_sect.is_displayed()\n' +
          '\n' +
          '            # adds card details\n' +
          '\n' +
          '        add_card_num = wait.until(\n' +
          '             EC.visibility_of_element_located(\n' +
          '                 (\n' +
          '                     AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          `                     'new UiSelector().resourceId("com.halaleats.user:id/card_number_edit_text")'\n` +
          '                 )\n' +
          '             ))\n' +
          '        add_card_num.click()\n' +
          '        add_card_num.clear()\n' +
          '        add_card_num.send_keys(card_num)\n' +
          '\n' +
          '        add_date = wait.until(\n' +
          '           EC.visibility_of_element_located(\n' +
          '               (\n' +
          '                   AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          `                   'new UiSelector().resourceId("com.halaleats.user:id/expiry_date_edit_text")'\n` +
          '               )\n' +
          '           ))\n' +
          '        add_date.click()\n' +
          '        add_date.clear()\n' +
          '        add_date.send_keys(exp_date)\n' +
          '\n' +
          '        add_cvc = wait.until(\n' +
          '           EC.visibility_of_element_located(\n' +
          '               (\n' +
          '                   AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          `                   'new UiSelector().resourceId("com.halaleats.user:id/cvc_edit_text")'\n` +
          '               )\n' +
          '           ))\n' +
          '        add_cvc.click()\n' +
          '        add_cvc.clear()\n' +
          '        add_cvc.send_keys(cvc)\n' +
          '\n' +
          '        driver.back()\n' +
          '\n' +
          '        # add card holder name\n' +
          '        add_name = wait.until(\n' +
          '           EC.element_to_be_clickable(\n' +
          '               (\n' +
          '                   AppiumBy.ANDROID_UIAUTOMATOR,\n' +
          `                   'new UiSelector().className("android.widget.EditText").instance(2)'\n` +
          '               )\n' +
          '           ))\n' +
          '        add_name.click()\n' +
          '        add_name.clear()\n' +
          '        add_name.send_keys(name)\n' +
          '\n' +
          '        driver.back()\n' +
          '\n' +
          '        # saves the card\n' +
          '        save_card = wait.until(\n' +
          '           EC.element_to_be_clickable(\n' +
          '               (\n' +
          '                   AppiumBy.ACCESSIBILITY_ID,\n' +
          "                   'Save Card'\n" +
          '               )\n' +
          '           ))\n' +
          '        save_card.click()\n' +
          '\n' +
          '\n' +
          '    finally:\n' +
          '        driver.quit()\n'
      },
      identifier: 'test_add_new_card',

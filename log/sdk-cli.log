    test_run: {
      type: 'test',
      framework: 'pytest',
      uuid: 'e6e901e4-898d-44d4-85f5-cf763f0f6140',
      name: 'test_select_halal_pref',
      body: {
        lang: 'python',
        code: 'def test_select_halal_pref():\n' +
          '    options = XCUITestOptions().load_capabilities({\n' +
          '        "platformName": "iOS",\n' +
          '        "automationName": "XCUITest",\n' +
          '    })\n' +
          '\n' +
          '    driver = webdriver.Remote(\n' +
          '        "http://127.0.0.1:4723",\n' +
          '        options=options\n' +
          '    )\n' +
          '\n' +
          '\n' +
          '    # Manual preparation window:\n' +
          '    # Grant permissions, complete onboarding/login,\n' +
          '    # and navigate to the home screen.\n' +
          '\n' +
          '    driver.execute_script(\n' +
          "        'browserstack_executor: {'\n" +
          `        '"action":"updateIosDeviceSettings",'\n` +
          `        '"arguments":{"LocationServices":"ON"}}'\n` +
          '    )\n' +
          '\n' +
          '    driver.execute_script(\n' +
          "        'browserstack_executor: {'\n" +
          `        '"action":"updateAppSettings",'\n` +
          `        '"arguments":{"Permission Settings":{'\n` +
          `        '"Location":{"ALLOW LOCATION ACCESS":"While Using the App"}'\n` +
          "        '}}}'\n" +
          '    )\n' +
          '\n' +
          '    driver.terminate_app("com.halaleats.customer")\n' +
          '    driver.activate_app("com.halaleats.customer")\n' +
          '\n' +
          '    time.sleep(60)\n' +
          '\n' +
          '    wait = WebDriverWait(driver, 20)\n' +
          '\n' +
          '    try:\n' +
          '\n' +
          '        # Confirm the home screen and open Account.\n' +
          '        nav_account = wait.until(\n' +
          '            EC.element_to_be_clickable((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Account"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        assert nav_account.is_displayed()\n' +
          '        print("User is on the home screen.")\n' +
          '\n' +
          '        nav_account.click()\n' +
          '\n' +
          '        # Scroll down to Halal preference.\n' +
          '        driver.execute_script(\n' +
          '            "mobile: scroll",\n' +
          '            {"name": "Halal preference"}\n' +
          '        )\n' +
          '\n' +
          '        halal_preference_navigation = wait.until(\n' +
          '            EC.element_to_be_clickable((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Halal preference"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        halal_preference_navigation.click()\n' +
          '\n' +
          '        # Confirm that the preference screen opened.\n' +
          '        preference_heading = wait.until(\n' +
          '            EC.visibility_of_element_located((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Select Your Halal Preference"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        assert preference_heading.is_displayed()\n' +
          '        print("Halal preference screen opened.")\n' +
          '\n' +
          '        # Select Fully Halal Certified.\n' +
          '        fully_certified = wait.until(\n' +
          '            EC.element_to_be_clickable((\n' +
          '                AppiumBy.IOS_PREDICATE,\n' +
          `                'name == "Fully Halal Certified" OR '\n` +
          `                'label == "Fully Halal Certified"'\n` +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        fully_certified.click()\n' +
          '\n' +
          '        # The iOS screen shows Continue, not Save.\n' +
          '        continue_button = wait.until(\n' +
          '            EC.element_to_be_clickable((\n' +
          '                AppiumBy.IOS_PREDICATE,\n' +
          `                'type == "XCUIElementTypeButton" AND '\n` +
          `                '(name CONTAINS "Continue" OR label CONTAINS "Continue")'\n` +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        continue_button.click()\n' +
          '\n' +
          '        # Capture the short confirmation message.\n' +
          '        confirmation = WebDriverWait(\n' +
          '            driver,\n' +
          '            5,\n' +
          '            poll_frequency=0.1\n' +
          '        ).until(\n' +
          '            EC.presence_of_element_located((\n' +
          '                AppiumBy.ACCESSIBILITY_ID,\n' +
          '                "Halal preference saved"\n' +
          '            ))\n' +
          '        )\n' +
          '\n' +
          '        assert confirmation.is_displayed()\n' +
          '        print("Halal preference saved successfully.")\n' +
          '\n' +
          '    finally:\n' +
          '        driver.quit()\n'
      },
      identifier: 'test_select_halal_pref',
      scope: 'test_select_halal_pref',
      scopes: [ 'tests', 'user_app', 'select_halal_prefer_bs_ios.py' ],
      file_name: 'tests\\user_app\\select_halal_prefer_bs_ios.py',
